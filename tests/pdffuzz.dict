# AFL++ dictionary for the PDF reader (main_fuzz.cpp, -DFUZZ_PDF): use
# with AFL++'s own dictionaries/pdf.dict.

# Structure
header="%PDF-1.7"
eof="%%EOF"
obj=" obj"
endobj="endobj"
stream="stream\x0a"
stream_crlf="stream\x0d\x0a"
endstream="\x0aendstream"
xref="xref\x0a"
trailer="trailer"
startxref="startxref"
dopen="<<"
dclose=">>"
ref=" 0 R"
free="0000000000 65535 f "
inuse="0000000009 00000 n "

# Keys
k_type="/Type"
